{
  "name": "letter-pantry",
  "version": "1.0.0",
  "private": true,
  "description": "Letter Pantry — an anagram word puzzle in a cozy 3D pantry, on the StarHermit engine.",
  "scripts": {
    "test": "npm run test:unit && npm run test:native",
    "test:unit": "node tests/run-tests.mjs && node --test tests/i18n.test.mjs tests/progress.test.mjs",
    "test:native": "node tests/native.mjs",
    "test:browser": "node tools/browser-play.mjs .",
    "package": "node tools/package-web.mjs",
    "css": "node tools/css.mjs",
    "plays": "node tools/gen-plays.mjs",
    "serve": "node server.js"
  },
