    ".panel": {
      "background": "$panel",
      "border": {
        "width": 2,
        "color": "$accent-dark",
        "style": "solid"
      },
      "radius": 14,
      "shadow": {
        "y": 12,
        "blur": 40,
        "color": "#00000080"
      },
      "padding": {
        "top": 24,
        "end": 32,
        "bottom": 24,
        "start": 32
      }
    },
    ".title-panel": {
      "background": [
        {
          "type": "linear",
          "stops": ["#1e140ce0", "#18100af2"]
        },
        {
          "image": "assets/title-backdrop.webp",
          "size": "cover",
          "position": {
            "x": 0.5,
            "y": 0.4
          },
          "repeat": true
        }
      ],
      "border": {
        "width": 2,
        "color": "$accent-dark",
        "style": "solid"
      },
      "radius": 14,
      "shadow": {
        "y": 12,
        "blur": 40,
        "color": "#00000080"
      },
      "padding": {
        "top": 24,
        "end": 32,
        "bottom": 24,
        "start": 32
      }
