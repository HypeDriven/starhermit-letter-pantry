      "radius": 10,
      "padding": {
        "top": 8.8,
        "end": 19.2,
        "bottom": 8.8,
        "start": 19.2
      },
      "minWidth": 44,
      "minHeight": 44,
      "text": {
        "color": "$text",
        "size": 16,
        "align": "center"
      },
      "hovered": {
        "background": "$btn-hover"
      },
      "focusVisible": {
        "focusRing": {
          "width": 3,
          "color": "$focus",
          "offset": 2
        }
      },
      "disabled": {
        "opacity": 0.45
      }
